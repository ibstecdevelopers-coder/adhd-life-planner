{
 "cleanUrls": false,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/(.*)sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/p/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ]
}